{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist-vercel",
  "rewrites": [
    { "source": "/api/:path+", "destination": "/api/service?route=:path+" },
    { "source": "/((?!api/|assets/|media/|favicon\\.svg).*)", "destination": "/index.html" }
  ]
}
